#!/usr/bin/env python3
"""Read an ordered list of source URLs from a spreadsheet.

Usage: bin/course-urls <file.xlsx|file.csv|dir>

Prints one URL per line, in row order: the first http(s) value found in each
row. A header row (or any row without a URL) is skipped automatically, so the
spreadsheet only needs a column of source URLs - the column name does not
matter. Used by the create-course workflow to turn an attached spreadsheet
into the same ordered URL list as a pasted list.

Given a directory (e.g. `bin/course-urls input`), it uses the single .xlsx or
.csv inside it, or lists the candidates and exits non-zero when there is more
than one.
"""
from __future__ import annotations

import csv
import re
import sys
import zipfile
from pathlib import Path
from xml.etree import ElementTree as ET

URL_RE = re.compile(r"^\s*(https?://\S+?)\s*$", re.IGNORECASE)
_SSML = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"


def _first_url(cells: list[str]) -> str | None:
    for cell in cells:
        match = URL_RE.match(cell or "")
        if match:
            return match.group(1)
    return None


def _rows_from_csv(path: Path) -> list[list[str]]:
    with path.open(newline="", encoding="utf-8-sig") as handle:
        return [list(row) for row in csv.reader(handle)]


def _rows_from_xlsx(path: Path) -> list[list[str]]:
    with zipfile.ZipFile(path) as archive:
        shared: list[str] = []
        if "xl/sharedStrings.xml" in archive.namelist():
            strings = ET.fromstring(archive.read("xl/sharedStrings.xml"))
            for si in strings.findall(f"{_SSML}si"):
                shared.append("".join(t.text or "" for t in si.iter(f"{_SSML}t")))

        sheet_names = sorted(
            n for n in archive.namelist()
            if re.fullmatch(r"xl/worksheets/sheet\d+\.xml", n)
        )
        if not sheet_names:
            return []
        sheet = ET.fromstring(archive.read(sheet_names[0]))

        rows: list[list[str]] = []
        for row in sheet.iter(f"{_SSML}row"):
            values: list[str] = []
            for cell in row.findall(f"{_SSML}c"):
                ref = cell.get("r", "")
                col = re.match(r"[A-Za-z]+", ref)
                index = 0
                if col:
                    for char in col.group(0).upper():
                        index = index * 26 + (ord(char) - 64)
                    index -= 1
                while len(values) <= index:
                    values.append("")
                text = ""
                value_node = cell.find(f"{_SSML}v")
                inline = cell.find(f"{_SSML}is")
                if cell.get("t") == "s" and value_node is not None:
                    ref_index = int(value_node.text)
                    text = shared[ref_index] if 0 <= ref_index < len(shared) else ""
                elif value_node is not None:
                    text = value_node.text or ""
                elif inline is not None:
                    text = "".join(t.text or "" for t in inline.iter(f"{_SSML}t"))
                values[index] = text
            rows.append(values)
        return rows


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    path = Path(argv[1])
    if path.is_dir():
        candidates = sorted(
            p for p in path.iterdir()
            if p.suffix.lower() in {".xlsx", ".xlsm", ".csv"}
        )
        if not candidates:
            print(f"course-urls: no .xlsx or .csv file in {path}", file=sys.stderr)
            return 66
        if len(candidates) > 1:
            print(
                f"course-urls: {path} holds more than one spreadsheet; name one:",
                file=sys.stderr,
            )
            for candidate in candidates:
                print(f"  {candidate}", file=sys.stderr)
            return 64
        path = candidates[0]
    if not path.is_file():
        print(f"course-urls: file not found: {path}", file=sys.stderr)
        return 66

    suffix = path.suffix.lower()
    if suffix == ".csv":
        rows = _rows_from_csv(path)
    elif suffix in {".xlsx", ".xlsm"}:
        rows = _rows_from_xlsx(path)
    else:
        print(
            f"course-urls: unsupported file type '{suffix}' (use .xlsx or .csv)",
            file=sys.stderr,
        )
        return 64

    urls = [url for row in rows if (url := _first_url(row))]
    if not urls:
        print("course-urls: no http(s) URLs found in the spreadsheet", file=sys.stderr)
        return 65

    seen: set[str] = set()
    for url in urls:
        if url not in seen:
            seen.add(url)
            print(url)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
