# ==============================================================
# FX Learning Agent - Environment Configuration (.env.example)
# Copy this file to .env and customize values for your deployment
# ==============================================================

# Server Network Configuration
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=INFO

# AI Engine / LLM Configuration
# LLM_PROVIDER: "local" (Ollama / vLLM) or "cloud" (OpenAI / Azure OpenAI / Anthropic)
LLM_PROVIDER=local

# Local Runner Settings (Ollama)
LLM_LOCAL_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:latest
LLM_TIMEOUT=60.0

# Cloud Runner Settings (Optional if using Cloud API keys)
LLM_CLOUD_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Azure Deployment Settings
# For Azure App Service: WEBSITES_PORT=8080 is automatically detected
# For Azure Container Apps: targetPort=8080
